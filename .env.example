# Comma-separated URLs or one URL per line.
TARGET_URLS=https://www.naukri.com/front-office-executive-jobs-in-hyderabad-secunderabad?expJD=true

# Google Sheet destination.
GOOGLE_SHEETS_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit

# Service-account JSON downloaded from Google Cloud.
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account.json

# Browser / scraper settings.
HEADLESS=true
REQUEST_TIMEOUT_MS=30000
MAX_PAGES_PER_TARGET=3
MAX_JOBS_PER_TARGET=100

# Debugging.
DEBUG=false
SAVE_HTML=false
SCREENSHOTS=false
OUTPUT_DIR=output
